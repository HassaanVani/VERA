# Server only. Standard mode; no Contributor-mode content sharing.
MODEL_API_KEY=
META_MODEL=muse-spark-1.3
META_IMAGE_MODEL=muse-image-1.0
VERA_IMAGE_USD_PER_IMAGE=0.01
META_REASONING_EFFORT=low
VERA_MAX_OUTPUT_TOKENS=16000
META_BASE_URL=https://api.meta.ai/v1
# Candidate model until npm run probe succeeds with your account.
VERA_DATA_DIR=.vera
# Shared by the app and isolated evaluation records.
VERA_BUDGET_DIR=.vera
VERA_BUDGET_BUCKET=development
VERA_INPUT_USD_PER_MILLION=1.25
VERA_OUTPUT_USD_PER_MILLION=4.25
VERA_CALL_RESERVATION_USD=0.50
VERA_PORT=3000
